# HTTP listen port.
#PORT=8000

# Set to exactly 1 to run a single process instead of one worker per CPU core.
# Any other value (true, yes, 0) leaves clustering ENABLED.
# Recommended for local dev and for attaching a debugger.
#NO_CLUSTER=1

# Override the number of cluster workers. Defaults to the CPU count, which on a
# 20-core machine means 20 workers, each able to launch its own headless Chrome.
#WORKER_POOL_SIZE=4

# Set to production to suppress console logging.
#NODE_ENV=production

# draw.io rendering host.
#DRAWIO_BASE_URL=https://viewer.diagrams.net

# Legacy alias for DRAWIO_BASE_URL.
#DRAWIO_SERVER_URL=

# Allow insecure HTTP requests (Heroku).
#ALLOW_HTTP=false

# Comma-separated API keys for the x-api-key header.
# Declared in app.json but NOT enforced in export.js.
#API_TOKENS=
